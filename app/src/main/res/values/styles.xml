<resources>
    <style name="Theme.CyberJur" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:statusBarColor">#00FFFFFF</item>
        <item name="buttonStyle">@style/MyButton</item>
        <item name="fontFamily">@font/cyberjur_font</item>
    </style>
    <style name="MyButton" parent="Widget.AppCompat.Button">
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="DialogSlideAnimation">
        <item name="android:windowEnterAnimation">@anim/slide_in_right</item>
        <item name="android:windowExitAnimation">@anim/slide_out_right</item>
    </style>
    <style name="CustomPopup" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">#383C47</item>
        <item name="android:textSize">15sp</item>
    </style>
    <style name="ModalSlideAnimation">
        <item name="android:windowEnterAnimation">@anim/slide_in_up</item>
        <item name="android:windowExitAnimation">@anim/slide_out_up</item>
    </style>
</resources>